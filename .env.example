# Copie para .env e preencha. O .env é ignorado pelo git desde o commit zero.

# --- Modo real (opcional; o modo demo roda 100% sem chave e sem custo) ---
ANTHROPIC_API_KEY=

# demo = gerador extrativo local, custo zero | real = LLM pago (Haiku)
RAG_MODO=demo

# Guard de custo: QUALQUER chamada paga exige RAG_PERMITIR_CUSTO=1 explícito
RAG_PERMITIR_CUSTO=0
RAG_TETO_CUSTO_USD=0.50
RAG_MODELO=claude-haiku-4-5

# --- Infra local ---
# embedded = chroma persistente em data/index/ | http = servidor chroma (docker-compose)
CHROMA_MODE=embedded
CHROMA_HOST=localhost
CHROMA_PORT=8001
